{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow.v1.json",
  "title": "Deck flow v1 (written in the maintainer's own Claude Code session; everything else in a flow record is computed)",
  "type": "object",
  "additionalProperties": false,
  "required": ["sections", "arc", "why_the_flow_works"],
  "properties": {
    "sections": {
      "type": "array",
      "description": "one section per visible slide, in deck order",
      "items": {"enum": ["cover", "hook", "executive-summary", "agenda", "situation", "problem-analysis", "customer", "competition", "solution", "how-it-works", "implementation", "financials", "risks", "kpis", "closing", "appendix", "other"]}
    },
    "arc": {"enum": ["problem-to-solution", "pillars", "journey", "options-to-pick", "chronological", "other"]},
    "why_the_flow_works": {"type": "string", "minLength": 20, "maxLength": 400}
  }
}
