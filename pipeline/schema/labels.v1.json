{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "labels.v1.json",
  "title": "Slide labels v1 (written in the maintainer's own Claude Code session)",
  "type": "object",
  "additionalProperties": false,
  "required": ["archetype", "purpose", "argument_shape", "insight_device", "data_type", "industry", "why_it_works", "regions", "text_patterns"],
  "properties": {
    "archetype": {"enum": ["title", "hook", "executive-summary", "section-divider", "situational-analysis", "problem-analysis", "internal-external", "market-trends", "customer", "options", "recommendation-overview", "recommendation-detail", "customer-journey", "implementation", "financials", "kpis-risks", "other"]},
    "purpose": {"type": "string", "minLength": 10, "maxLength": 200},
    "argument_shape": {"enum": ["single-claim", "comparison", "sequence", "hierarchy", "cause-effect", "problem-solution", "framework", "evidence-stack", "trade-off", "timeline", "overview"]},
    "insight_device": {"enum": ["big-number", "highlight-contrast", "spotlight", "callout-annotation", "ranking", "before-after", "benchmark", "trend-line", "matrix-position", "visual-metaphor", "none"]},
    "data_type": {"enum": ["none", "quantitative-chart", "kpi-numbers", "table", "timeline", "process", "map", "qualitative", "image-led"]},
    "industry": {"enum": ["consumer-retail", "food-beverage", "financial-services", "technology", "telecom-media", "healthcare-pharma", "energy-utilities", "industrials-manufacturing", "transportation-logistics", "travel-hospitality", "automotive", "real-estate-construction", "public-nonprofit-education", "professional-services", "cross-industry"]},
    "why_it_works": {"type": "string", "minLength": 20, "maxLength": 400},
    "when_to_use": {"type": "string", "minLength": 1, "maxLength": 160},
    "effect": {"type": "string", "minLength": 1, "maxLength": 160},
    "elements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "note"],
        "properties": {
          "component": {"type": "integer", "minimum": 0},
          "note": {"type": "string", "minLength": 1, "maxLength": 120}
        }
      }
    },
    "regions": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {"^[0-9]+$": {"$ref": "#/$defs/role"}}
    },
    "text_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["region", "pattern", "words"],
        "properties": {
          "region": {"type": "integer", "minimum": 0},
          "pattern": {"type": "string", "minLength": 3, "maxLength": 80},
          "words": {"type": "integer", "minimum": 0, "maximum": 500}
        }
      }
    }
  },
  "$defs": {
    "role": {"enum": ["title", "tagline", "subtitle", "section-label", "body", "bullet-list", "big-number", "number-label", "chart", "table", "image", "icon", "logo", "card", "callout", "label", "background-band", "divider", "connector", "footer", "source-note", "page-number", "decoration", "group", "other"]}
  }
}
