{
  "name": "eightytwenty",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": false },
  "rules": [{ "type": "Text", "globs": ["**/*.md", "**/*.svg"], "fallthrough": true }],
  // Wireframes are read only through the ASSETS binding: run_worker_first sends every request to the Worker,
  // which never forwards to ASSETS, so no public URL serves them.
  "assets": { "directory": "../library/assets", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "eightytwenty-db", "database_id": "0dfdc973-0aec-43de-b125-aa2501aa86e9", "migrations_dir": "migrations" }],
  "ai": { "binding": "AI", "remote": true },
  // Searcher runs uncached searches: a Durable Object's CPU time is not counted against the Worker's.
  "durable_objects": { "bindings": [{ "name": "LIMITER", "class_name": "Limiter" }, { "name": "SEARCHER", "class_name": "Searcher" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Limiter"] }, { "tag": "v2", "new_sqlite_classes": ["Searcher"] }],
  // No cron: every library load (records.sql) clears the search cache. An empty list removes the old daily trigger.
  "triggers": { "crons": [] },
  "vars": {
    // Tool calls per minute per client IP (IPv6: per /64). Over it: 429 and a cooldown of 1, 2, 4 ... 60 minutes.
    "LIMIT_PER_MINUTE": 20,
    // Tool calls per minute for the bucket all of Anthropic's egress IPs share (claude.ai users).
    "LIMIT_PER_MINUTE_SHARED": 300,
    // find_references + find_deck_flows calls per UTC day across all clients (protects the Workers AI and D1 free quotas).
    "DAILY_SEARCH_BUDGET": 5000,
    // find_images photo searches per UTC day across all clients that miss the cache (sized to Openverse's app quota).
    // OPENVERSE_CLIENT_ID and OPENVERSE_CLIENT_SECRET are secrets: wrangler secret put, never here.
    // OPENAI_APPS_CHALLENGE (ChatGPT's domain verification token) is a secret too.
    "DAILY_PHOTO_BUDGET": 1000
  }
}
